// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════

enum Role {
  USER
  VENDOR
  ADMIN
}

enum UserStatus {
  UNVERIFIED
  VERIFIED
  LOCKED
}

enum VendorStatus {
  PENDING    // Chờ Admin duyệt
  APPROVED   // Đã duyệt
  REJECTED   // Từ chối
  SUSPENDED  // Tạm khóa
}

enum ApprovalStatus {
  DRAFT      // Vendor đang soạn, chưa gửi duyệt
  PENDING    // Chờ Admin duyệt
  APPROVED   // Đã duyệt, hiển thị trên sàn
  REJECTED   // Admin từ chối
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  MOMO
  VNPAY
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  BOOKING_INCOME     // Thu nhập từ đơn đặt phòng
  COMMISSION_FEE     // Phí hoa hồng sàn trừ
  WITHDRAWAL         // Vendor rút tiền
  REFUND             // Hoàn tiền cho khách
  ADJUSTMENT         // Admin điều chỉnh thủ công
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ══════════════════════════════════════════════════════════
// USER & AUTHENTICATION
// Phục vụ: Đăng nhập, Đăng ký, Quên MK, Hồ sơ cá nhân,
//           QL Người dùng (Admin)
// ══════════════════════════════════════════════════════════

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  avatar    String?
  role      Role       @default(USER)
  status    UserStatus @default(UNVERIFIED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  vendorProfile  VendorProfile?
  bookings       Booking[]
  reviews        Review[]
  otps           UserOtp[]
  supportTickets SupportTicket[]
  ticketMessages TicketMessage[]

  @@map("users")
}

model UserOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  otpCode   String
  type      String   // Ví dụ: "REGISTER", "FORGOT_PASSWORD"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_otps")
}

// ══════════════════════════════════════════════════════════
// VENDOR / CHỦ PHÒNG
// Phục vụ: Đăng ký Shop, Dashboard Vendor, Ví điện tử
// ══════════════════════════════════════════════════════════

model VendorProfile {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  shopName     String       @unique                      // Tên cửa hàng / thương hiệu
  description  String?      @db.Text                     // Giới thiệu ngắn
  businessLicense String?                                // Số GPKD (tùy chọn)
  bankName     String?                                   // Tên ngân hàng
  bankAccount  String?                                   // Số tài khoản
  bankOwner    String?                                   // Tên chủ TK
  logo         String?                                   // URL logo
  status       VendorStatus @default(PENDING)
  commissionRate Float      @default(10)                 // % hoa hồng sàn (mặc định 10%)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotels Hotel[]
  wallet Wallet?

  @@map("vendor_profiles")
}

model Wallet {
  id        Int      @id @default(autoincrement())
  vendorId  Int      @unique
  balance   Float    @default(0)       // Số dư hiện tại
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       VendorProfile       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          Int             @id @default(autoincrement())
  walletId    Int
  bookingId   Int?                                       // Liên kết đơn hàng (nếu có)
  type        TransactionType
  amount      Float                                      // Số tiền (dương = cộng, âm = trừ)
  description String?         @db.Text
  createdAt   DateTime        @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([bookingId])
  @@map("wallet_transactions")
}

// ══════════════════════════════════════════════════════════
// HOTEL & ROOM
// Phục vụ: Trang chủ, Tìm kiếm, Chi tiết KS, QL Phòng,
//           Duyệt sản phẩm, QL Sản phẩm Vendor
// ══════════════════════════════════════════════════════════

model Hotel {
  id             Int            @id @default(autoincrement())
  vendorId       Int?                                    // null = do Admin tạo (legacy)
  name           String         @unique
  description    String?        @db.Text
  location       String
  city           String
  country        String
  rating         Float          @default(0)
  amenities      Json?                                   // Mảng JSON tiện ích
  images         Json?                                   // Mảng JSON URL ảnh
  approvalStatus ApprovalStatus @default(DRAFT)          // Trạng thái duyệt của Admin
  rejectReason   String?        @db.Text                 // Lý do từ chối (nếu có)
  isActive       Boolean        @default(true)           // Vendor tắt/bật hiển thị
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vendor  VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  rooms   Room[]
  reviews Review[]

  @@index([vendorId])
  @@index([city])
  @@index([approvalStatus])
  @@map("hotels")
}

model Room {
  id          Int      @id @default(autoincrement())
  hotelId     Int
  roomNumber  String
  type        String   // Ví dụ: "single", "double", "suite", "deluxe"
  price       Float
  capacity    Int
  description String?  @db.Text
  amenities   Json?    // Mảng JSON tiện ích phòng
  images      Json?    // Mảng JSON URL ảnh phòng
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

// ══════════════════════════════════════════════════════════
// BOOKING & PAYMENT
// Phục vụ: Tóm tắt đặt chỗ, Thanh toán, Lịch sử,
//           QL Đơn hàng Vendor, Báo cáo doanh thu
// ══════════════════════════════════════════════════════════

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int
  roomId        Int
  promotionId   Int?                                     // Mã khuyến mãi đã áp dụng
  checkInDate   DateTime
  checkOutDate  DateTime
  adults        Int           @default(1)
  children      Int           @default(0)
  specialNote   String?       @db.Text
  status        BookingStatus @default(PENDING)
  totalPrice    Float                                    // Giá gốc
  discountAmount Float        @default(0)                // Số tiền giảm
  finalPrice    Float                                    // = totalPrice - discountAmount
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  room               Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  promotion          Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  payment            Payment?
  review             Review?
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  amount        Float
  method        PaymentMethod
  transactionId String?                                  // Mã giao dịch từ cổng thanh toán
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?                                // Thời điểm thanh toán thành công
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ══════════════════════════════════════════════════════════
// REVIEW
// Phục vụ: Đánh giá sản phẩm, QL Bình luận Vendor
// ══════════════════════════════════════════════════════════

model Review {
  id            Int       @id @default(autoincrement())
  userId        Int
  hotelId       Int
  bookingId     Int?      @unique                        // Liên kết đơn đặt phòng (1 booking → 1 review)
  rating        Int                                      // 1-5
  comment       String?   @db.Text
  vendorReply   String?   @db.Text                       // Vendor phản hồi
  vendorReplyAt DateTime?                                // Thời điểm phản hồi
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([userId])
  @@map("reviews")
}

// ══════════════════════════════════════════════════════════
// PROMOTION / KHUYẾN MÃI
// Phục vụ: QL Khuyến mãi Vendor
// ══════════════════════════════════════════════════════════

model Promotion {
  id             Int       @id @default(autoincrement())
  vendorId       Int                                     // Vendor sở hữu mã
  code           String    @unique                       // Mã giảm giá, VD: "SUMMER2026"
  name           String                                  // Tên chương trình
  description    String?   @db.Text
  discountType   String    @default("percentage")        // "percentage" | "fixed"
  discountValue  Float                                   // Giá trị giảm (% hoặc VND)
  minOrderValue  Float     @default(0)                   // Đơn tối thiểu
  maxDiscount    Float?                                  // Giảm tối đa (cho loại %)
  usageLimit     Int?                                    // Giới hạn lượt sử dụng
  usedCount      Int       @default(0)                   // Số lượt đã dùng
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings Booking[]

  @@index([vendorId])
  @@index([code])
  @@map("promotions")
}

// ══════════════════════════════════════════════════════════
// SUPPORT / HỖ TRỢ KHÁCH HÀNG
// Phục vụ: Hỗ trợ khách hàng (Tickets) - Admin
// ══════════════════════════════════════════════════════════

model SupportTicket {
  id         Int            @id @default(autoincrement())
  userId     Int
  bookingId  Int?                                        // Liên kết đơn hàng (nếu có)
  subject    String
  category   String         @default("general")          // "booking", "payment", "account", "general"
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  senderId  Int                                          // userId của người gửi (user hoặc admin)
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

// ══════════════════════════════════════════════════════════
// CMS / QUẢN LÝ NỘI DUNG
// Phục vụ: Quản lý nội dung (CMS) - Admin
// ══════════════════════════════════════════════════════════

model CmsPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique                           // URL-friendly, VD: "about-us"
  title       String
  content     String   @db.LongText                      // Nội dung HTML/Markdown
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)                       // Thứ tự hiển thị
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_pages")
}